# Copy to .env for local development only. On Railway, set these as
# service Variables instead. Never commit a real key.
# Without META_API_KEY the app runs in simulated (demo) mode.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_NAME=muse-spark-1.3

# Optional per-token pricing for the daily spend guard (cost per
# million tokens, in the same currency as LIVE_DAILY_BUDGET_USD).
# Pricing is never hard-coded: set both from your provider's current
# pricing, or leave both unset. If either is unset or invalid, cost
# is treated as unknown, no spend is estimated, and only the daily
# call-count limit below applies (a budget of 0 is still a hard
# block). Never commit real values.
# META_INPUT_COST_PER_MTOK=
# META_OUTPUT_COST_PER_MTOK=

# Optional abuse limits for the live endpoint (defaults shown).
# 0 is a hard block (no live calls), not unlimited.
# LIVE_RATE_PER_MINUTE=5
# LIVE_RATE_PER_HOUR=30
# LIVE_DAILY_MAX_CALLS=300
# LIVE_DAILY_BUDGET_USD=5
# LIVE concurrency is capped at 2; upstream max_tokens defaults to
# 4096 and META_MAX_TOKENS is hard-capped at 8192.
# META_MAX_TOKENS=4096
# ALLOWED_ORIGINS=https://meta.lanemint.com
