# Meta API configuration
# META_API_KEY is required for live runs; MODEL_API_KEY is accepted as a fallback.
# Live mode note: Meta's Model API is region-gated (US region).
# All keys below are runtime-only: copy this file to `.env` (gitignored)
# or export the variables in your shell / Docker Compose environment.
# Never commit real values, and never bake them into a Docker image.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_NAME=muse-spark-1.3

# Fireworks (open Muse models): passed through at runtime for
# Fireworks-based tooling. The benchmark runner itself reads its key
# from META_API_KEY, so when pointing META_BASE_URL at Fireworks put
# the Fireworks key in META_API_KEY above (see "Reproduce" in README.md).
FIREWORKS_API_KEY=

# Site key for the deployed web app, if your deployment uses one.
# The benchmark runner does not read this; the web app's live mode
# uses META_API_KEY. Runtime-only, like the keys above.
META_SITE_API_KEY=

# Optional: output token cap. Leave unset to use the runner defaults
# (16000 for easy-tier tasks, 32000 for hard-tier tasks); setting this
# overrides both tiers, so do not set it to 16000 for hard-tier runs.
# META_MAX_TOKENS=32000

# Optional: control reasoning effort (if supported by model)
# META_REASONING_EFFORT=medium

# Optional, app only (app/muse_client.py): per-token pricing for the
# web app's daily spend guard, as cost per million tokens. Pricing is
# never hard-coded; set both from your provider's current pricing or
# leave both unset, in which case cost is treated as unknown and the
# app enforces its live call-count limits only. Never commit values.
# META_INPUT_COST_PER_MTOK=
# META_OUTPUT_COST_PER_MTOK=
